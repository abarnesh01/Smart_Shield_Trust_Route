
# ─── AI Smart Shield Trust Route — Environment Configuration ───────────────────
# Copy this file to .env (for local dev) or .env.prod (for production equivalent)
# NEVER commit the filled-in file. .env.prod and .env are in .gitignore.
#
# Generate strong secrets with:
#   openssl rand -hex 32

# 1. Runtime environment
ENVIRONMENT=production     # production | staging | development
DEBUG=False

# 2. Database
# Local development (SQLite):
#   DATABASE_URL=sqlite:///./smartshield.db
# Production/Staging (PostgreSQL — replace with your actual connection string):
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg2://smartshield:CHANGE_ME@localhost:5432/smartshield

# 3. PostgreSQL (used only by docker-compose.prod.yml)
POSTGRES_USER=smartshield
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=smartshield

# 4. Security — REQUIRED in production/staging
# Generate: openssl rand -hex 32
SECRET_KEY=
JWT_SECRET_KEY=

# Admin/Dispatcher registration gate — keep private, never expose to browser
ADMIN_REGISTRATION_CODE=

# 5. Cookie and HTTPS
COOKIE_SECURE=True   # must be True when serving over HTTPS

# 6. CORS — restrict to EXACT frontend origin(s), no wildcards
# Example: '["https://smart-shield-app.onrender.com"]'
# Multiple: '["https://smart-shield-app.onrender.com","https://staging.example.com"]'
BACKEND_CORS_ORIGINS=

# 7. Bootstrap dev users (development only)
# Set True only locally; keep False in staging/production
BOOTSTRAP_DEV_USERS=false
# Passwords only read when BOOTSTRAP_DEV_USERS=true
# DEV_ADMIN_PASSWORD=
# DEV_DISPATCHER_PASSWORD=
# DEV_RIDER_PASSWORD=

# 8. Google Maps (optional — falls back to OSRM/OpenStreetMap)
GOOGLE_MAPS_API_KEY=

# 9. SMS Alerts — Twilio (optional — falls back to log-only mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EMERGENCY_PHONE=

# 10. Email Alerts — SMTP (optional — falls back to log-only mode)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
EMERGENCY_EMAIL=

# 11. Frontend API URL (build-time injection for docker-compose)
REACT_APP_API_URL=https://smart-shield-api.onrender.com

# 12. Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=

# 13. Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
